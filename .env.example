# Copy to `.env` — docker compose reads this for ${...} interpolation, and the
# backend reads the same names directly (pydantic-settings) for non-Docker runs.

# --- Postgres ---
POSTGRES_USER=aidlp
POSTGRES_PASSWORD=aidlp
POSTGRES_DB=aidlp
POSTGRES_PORT=5432

# --- Backend (local non-Docker defaults) ---
DATABASE_URL=postgresql+psycopg2://aidlp:aidlp@localhost:5432/aidlp
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Ports / build ---
API_PORT=8000
REDIS_PORT=6379
FRONTEND_PORT=3000
# Set INSTALL_ML=0 + SEMANTIC_ENABLED=false for a much smaller/faster image build
# (falls back to the lexical similarity scorer; see README "Lightweight mode").
INSTALL_NLP=1
INSTALL_ML=1
PRESIDIO_ENABLED=true
SEMANTIC_ENABLED=true

# --- Capture storage mode ---
# full = store every prompt verbatim + classify each one;
# minimal = hash + redacted preview only, raw text kept for flagged rows.
STORAGE_MODE=full
RETENTION_DAYS_FULL=30
# Prompts-only monitoring: AI response text is never stored (recommended).
CAPTURE_RESPONSES=false

# --- Data minimization (used when STORAGE_MODE=minimal) ---
RETENTION_DAYS_DEFAULT=30
RETENTION_DAYS_FLAGGED=180

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Production / sharing stack (docker-compose.prod.yml) ---
# Required by the prod file — compose fails fast when any of these are empty.
# DNS name pointing at your VM (Caddy gets the HTTPS cert for it automatically):
DOMAIN=
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (keep the prod values DIFFERENT from the dev defaults above)
# SECRET_KEY=  <- already set above; rotate it for production
# POSTGRES_PASSWORD=  <- already set above; rotate it for production
# Classify in the Celery worker (default, scales) or inline in the API (tiny VMs):
CLASSIFY_SYNC=false
# Small free-tier VM? Use the lightweight image build:
#   INSTALL_NLP=0
#   INSTALL_ML=0
#   SEMANTIC_ENABLED=false
