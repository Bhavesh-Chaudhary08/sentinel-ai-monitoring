{
  "manifest_version": 3,
  "name": "Sentinel — AI Usage Monitor",
  "version": "0.1.0",
  "description": "Consented capture of AI prompts with content-aware DLP on enrolled devices. The monitoring state is always visible to the user.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "alarms",
    "tabs",
    "idle"
  ],
  "host_permissions": [
    "https://*.chat.openai.com/*",
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "https://*.gemini.google.com/*",
    "https://*.aistudio.google.com/*",
    "https://*.claude.ai/*",
    "https://*.anthropic.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://*.github.com/*",
    "https://*.perplexity.ai/*",
    "https://*.poe.com/*",
    "https://*.character.ai/*",
    "https://*.you.com/*",
    "https://*.deepseek.com/*",
    "https://*.mistral.ai/*",
    "https://*.huggingface.co/*",
    "https://sentinel-7rlb.onrender.com/*",
    "http://localhost:8000/*",
    "http://localhost:8001/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Usage Monitor status",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://github.com/*",
        "https://perplexity.ai/*",
        "https://poe.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
